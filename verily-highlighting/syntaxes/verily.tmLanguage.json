{
	"$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
	"name": "verily",
	"patterns": [
		{
			"include": "#keywords"
		},
		{
			"include": "#doubleStrings"
		},
		{
			"include": "#storage"
		},
		{
			"include": "#comments"
		}
	],
	"repository": {
		"comments": {
			"patterns": [
				{
					"match": "#.*",
					"name": "comment.line.number-sign.verily"
				},
				{
					"match": "//.*",
					"name": "comment.line.double-slash.verily"
				},
				{
					"match": "--.*",
					"name": "comment.line.double-dash.verily"
				}
			]
		},
		"doubleStrings": {
			"begin": "\"",
			"end": "\"",
			"name": "string.quoted.double.verily",
			"patterns": [
				{
					"match": "\\\\.",
					"name": "constant.character.escape.verily"
				}
			]
		},
		"keywords": {
			"patterns": [
				{
					"match": "\\b(have|rw|rewrite|sweep|on|by|forward|fw|backward|bw|wts|notation|infix|prefix|postfix|before|option|as|ls|help|quit|setting|axiom|include|exists|forall|lambda|over|given|deduce|theorem)\\b",
					"name": "keyword.control.verily"
				}
			]
		},
		"storage": {
			"patterns": [
				{
					"match": "\\b[a-zA-Z0-9_]+(?=(<.*>)?\\()\\b",
					"name": "variable.name.verily"
				},
				{
					"match": "\\b(\\.|:|;|,|==|')\\b",
					"name":"keyword.operator.verily"
				}
			]
		}
	},
	"scopeName": "source.verily"
}