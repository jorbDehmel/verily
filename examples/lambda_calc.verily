# Lambda calculus.
# This holds for any objects implementing subs.

notation lambda:
  over x, M
  given lambda x . M
  deduce (lambda x M)
;
notation subs:
  over M x N
  given M[x = N]
  deduce (subs M x N)
  before lambda
;

axiom beta_reduction:
  over x, M, N
  given (lambda x. M) N
  deduce M[x = N]
;

axiom alpha_reduction:
  over x, y, M
  given (lambda x. M)
  deduce (lambda y. M[x = y])
;

axiom lambda_calc_subs:
  over x, y, M, N
  given (lambda x. M)[y = N]
  deduce lambda x. M[y = N]
;

----------------------------------------------------------------

axiom subs_atom:
  over x, M
  given (subs x x M)
  deduce M
;

theorem lemma_1:
  given (lambda x. lambda y. x) 1
  deduce lambda y. 1
by {
  fw beta_reduction on h0 as h1
  fw lambda_calc_subs on h1 as h2
  fw subs_atom on h2
}

theorem:
  given (((lambda x. lambda y. x) 1) 2)
  deduce 1
by {
  fw beta_reduction on 0
  ls
}
