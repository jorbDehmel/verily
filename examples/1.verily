include "std.verily";

axiom mp:
  over p, q
  given p, p implies q
  deduce q
;

axiom double_negation_introduction:
  over p
  given p
  deduce not not p
;

axiom: deduce is_raining;
axiom: deduce is_raining implies not is_sunny;

theorem:
  deduce not is_sunny
by {
  fw r3 as a
  fw r4 as b
  fw mp on a, b
}

theorem:
  deduce not not not is_sunny
by {
  fw r3 as a
  fw r4 as b
  bw double_negation_introduction
  fw mp on a, b as c
  ls
}
