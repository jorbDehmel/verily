rule:
  over D
  deduce Nil in List::D
;

rule:
  over x, y, D
  given x in D, y in List::D
  deduce Cons(x, y) in List::D
;

rule:
  over f, s
  deduce match(Nil, f, s) == f
;

# This doesn't really work (how do you get data and next?)
rule:
  over data, next, f, s
  deduce match(Cons(data, next), f, s) == s
;

axiom: x in D;
axiom: y in D;
theorem: Cons(x, Cons(y, Nil)) in List::D;

theorem:
  match(Cons(x, Nil), false, true) == true
;

theorem:
  match(Nil, true, false) == true
;
