# Gentzen-style (intuitionist) sequent calculus
include "std.verily";

# Lists
notation append:
  over A, B
  given A, ++, B
  deduce (append A B)
  before in
;

axiom singleton_list: over A deduce A in A;
axiom cons_list_l: over A, B given A in B deduce A in B ++ C;
axiom cons_list_r: over A, B, C given A in C deduce A in B ++ C;
axiom in_empty_set: over A given A in empty_set deduce false;

axiom derives_intro:
  over A
  given A
  deduce empty_set derives A
;

axiom derives_elim:
  over A
  given empty_set derives A
  deduce A
;

# Actual ISC rules
axiom sc_assumption:
  over A, B
  given A in B
  deduce B derives A
;
axiom sc_and_intro:
  over G, A, B
  given G derives A, G derives B
  deduce G derives A and B
;
axiom sc_or_intro_l:
  over G, A, B
  given G ++ B derives A
  deduce G derives A or B
;
axiom sc_or_intro_r:
  over G, A, B
  given G ++ A derives B
  deduce G derives A or B
;
axiom sc_implies_intro:
  over G, A, B
  given G ++ A derives B
  deduce G derives A implies B
;
axiom sc_left_and_1:
  over G, A, B, C
  given G ++ A derives C
  deduce G ++ (A and B) derives C
;
axiom sc_left_and_2:
  over G, A, B, C
  given G ++ B derives C
  deduce G ++ (A and B) derives C
;
axiom sc_left_or:
  over G, A, B, C
  given
    G ++ A derives C,
    G ++ B derives C
  deduce G ++ (A or B) derives C
;
axiom sc_left_implies:
  over G, A, B, C
  given
    G derives A,
    G ++ B derives C
  deduce G ++ (A implies B) derives C
;
axiom sc_left_false:
  over G, C
  deduce G ++ false derives C
;
axiom sc_cut:
  over G, A, B
  given
    G derives A implies B,
    G derives A
  deduce G derives B
;
