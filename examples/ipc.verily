# Intuitionist propositional calculus

# Taken from page 27 of
# "Lectures on the Curry-Howard Isomorphism"
# by Sorensen and Urzyczyn
# Example theorems taken from same source

setting "meta_prove=false";
# setting "alternate=true";
setting "pass_limit=8";

# rule set_1:
#   over a
#   deduce a in Set(a)
# ;
# rule set_2:
#   over a, b
#   deduce a in Set(a, b)
# ;
rule set_3:
  over a, b
  deduce a in Set(b, a)
;
# rule set_4:
#   over a, b, c
#   given a in b
#   deduce a in Set(c, b)
# ;
rule set_5:
  over a, b, c
  given a in c
  deduce a in Set(c, b)
;

