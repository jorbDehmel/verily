# Intuitionist propositional calculus (IPC)
# Known in other literature as IPL (IPC[calculus := logic])

# Taken from page 27 of
# "Lectures on the Curry-Howard Isomorphism"
# by Sorensen and Urzyczyn
# Example theorems taken from same source
# Uses binary tuple trees to capture set presence

setting "meta_prove=false";
setting "alternate=false";

include "tuple_rules.verily";

rule axiom_schema:
  over Gamma, phi
  deduce (Gamma, phi) derives phi
;

rule and_introduction:
  over Gamma, phi, psi
  given
    Gamma derives phi,
    Gamma derives psi
  deduce Gamma derives phi and psi
;

rule and_elimination_1:
  over Gamma, phi, psi
  given Gamma derives phi and psi
  deduce Gamma derives phi
;

rule and_elimination_2:
  over Gamma, phi, psi
  given Gamma derives phi and psi
  deduce Gamma derives psi
;

rule or_introduction_1:
  over Gamma, phi, psi
  given Gamma derives phi
  deduce Gamma derives phi or psi
;

rule or_introduction_2:
  over Gamma, phi, psi
  given Gamma derives psi
  deduce Gamma derives phi or psi
;

rule or_elimination:
  over Gamma, phi, rho, psi
  given
    (Gamma, phi) derives rho,
    (Gamma, psi) derives rho,
    Gamma derives phi or psi
  deduce Gamma derives rho
;

rule implies_introduction_simple_case:
  over phi, psi
  given (phi,) derives psi
  deduce () derives phi implies psi
;

# AKA deduction theorem
rule implies_introduction:
  over Gamma, phi, psi
  given (Gamma, phi) derives psi
  deduce Gamma derives phi implies psi
;

# AKA modus ponens
rule implies_elimination:
  over Gamma, phi, psi
  given
    Gamma derives phi implies psi,
    Gamma derives phi
  deduce Gamma derives psi
;

rule false_elimination:
  over Gamma, phi
  given Gamma derives false
  deduce Gamma derives phi
;

rule direct_derivation:
  over phi, Gamma
  given phi in Gamma
  deduce Gamma derives phi
;

# Proven as in the source
prove: () derives phi implies phi;
prove: () derives phi implies (psi implies phi);

