# Ordered rings as algebraic structures

include "std.verily";
include "eq.verily";

# Notations
notation negate: over X given neg X deduce (neg X) before in;

# Ring axioms
axiom 0_in_ring: over R given ring R deduce 0 in R;
axiom 1_in_ring: over R given ring R deduce 1 in R;
axiom negation_in_ring:
  over R, x given ring R, x in R deduce neg a in R;
axiom ring_add_assoc:
  over R, a, b, c given ring R, a in R, b in R, c in R
  deduce (a + b) + c == a + (b + c);
axiom ring_add_comm:
  over R, a, b given ring R, a in R, b in R
  deduce a + b == b + a;
axiom ring_add_neg:
  over R, a given ring R, a in R deduce a + (neg a) == 0;
axiom ring_mul_assoc:
  over R, a, b, c given ring R, a in R, b in R, c in R
  deduce (a * b) * c == a * (b * c);
axiom ring_mul_one:
  over R, a given ring R, a in R deduce a * 1 == a;
axiom ring_one_mul:
  over R, a given ring R, a in R
  deduce 1 * a == a;
axiom ring_left_expand:
  over R, a, b, c given ring R, a in R, b in R, c in R
  deduce a * (b + c) == (a * b) + (a * c);
axiom ring_right_expand:
  over R, a, b, c given ring R, a in R, b in R, c in R
  deduce (b + c) * a == (b * a) + (c * a);

# Totally-ordered set (toset) axioms
axiom toset_le_self:
  over S, a given toset S, a in S
  deduce a <= a;
axiom toset_le_trans:
  over S, a, b, c
  given toset S, a in S, b in S, c in S, a <= b, b <= c
  deduce a <= c;
axiom toset_le_to_eq:
  over S, a, b
  given toset S, a in S, b in S, a <= b, b <= a
  deduce a == b;
axiom toset_total_ordering:
  over S, a, b given toset S, a in S, b in S
  deduce (a <= b) or (b <= a);
axiom toset_le_to_ge:
  over S, a, b given toset S, a in S, b in S, a <= b
  deduce b >= a;
axiom toset_ge_to_le:
  over S, a, b given toset S, a in S, b in S, b >= a
  deduce a <= b;

# Ordered ring (oring) axioms
axiom oring_is_ring: over S given oring S deduce ring S;
axiom oring_is_toset: over S given oring S deduce toset S;
axiom oring_add_le_add:
  over S, a, b, c given oring S, a in S, b in S, c in S, a <= b
  deduce a + c <= b + c;
axiom oring_0_le:
  over S, a, b given oring S, a in S, b in S, 0 <= a, 0 <= b
  deduce 0 <= a * b;

----------------------------------------------------------------
# Theorems

# Any element of any ordered ring, when squared, is nonnegative
theorem: over t, S given oring S, t in S deduce 0 <= t * t by {
  # Unpack definitions
  have oring S as s_is_oring
  have t in S as t_in_s
  forward oring_is_ring on s_is_oring as s_is_ring
  forward oring_is_toset on s_is_oring as s_is_toset

  # Actual proof
  forward 0_in_ring on s_is_ring as 0_in_s
  forward toset_total_ordering
    on s_is_toset, t_in_s, 0_in_s
    as t_le_0_or_0_le_t

  # Trivial direction
  lemma: given t <= 0 deduce 0 <= t * t by {
    have t <= 0 as h2
    ls
  }

  # Hard direction
  lemma: given 0 <= t deduce 0 <= t * t by {
    have 0 <= t as h2
    ls
  }

  # TODO: How do we finish this?
  ls
}
