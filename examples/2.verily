include "std.verily";

axiom 0_is_even:
  deduce is_even 0
;

axiom plus_2_is_even:
  over n
  given is_even n
  deduce is_even (S (S n))
;

theorem 4_is_even:
  deduce is_even (S (S (S (S 0))))
by {
  fw 0_is_even as 0_is_even_thm
  fw plus_2_is_even on 0_is_even_thm as 2_is_even
  bw plus_2_is_even
}
