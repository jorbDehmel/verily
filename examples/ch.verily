# Attempt to use the Curry-Howard Isomorphism in verily

rule application_typing:
  over f, x, A, B
  given
    f: A to B,
    x: A
  deduce f(x): B
;

axiom: a in A;
axiom: g: A to B;
prove_forward: g(a): B;

rule abstraction_typing:
  over B, x, A, M
  given (x in A) derives (M in B)
  deduce (lambda x in A. M) in (A to B)
;

setting "meta_prove=true";
setting "alternate=true";

# Load-bearing lemma! Otherwise it runs out of juice before
# proving the subsequent theorem.
lemma:
  ((c in One) derives (N in Two))
  implies (lambda c in One. N): One to Two
;

theorem:
  ((c in One) derives (N in Two))
  implies (
    b in One
    implies
    (lambda c in One. N)(b): Two
  )
;
